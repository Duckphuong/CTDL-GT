function createToggle(id, toggleClass) {
    const element = id === "body"
        ? document.body
        : document.getElementById(id);

    let isOpen = element.classList.contains(toggleClass);

    return function () {
        isOpen = !isOpen;
        element.classList.toggle(toggleClass, isOpen);

        if (id === "body") {
            localStorage.setItem("theme", isOpen ? "dark" : "light");
        }
    };
}function createToggle(id, toggleClass) {
    return function () {
        if (id === 'body') {
            document.body.classList.toggle(toggleClass)
            localStorage.setItem("theme", document.body.classList.contains("dark") ? 'dark' : 'light')
        }
        else {
            const element = document.getElementById(id)
            if (!element) return
            element.classList.toggle(toggleClass)
        }
    }
}

// dark / light mode
const changeTheme = createToggle('body', 'dark')
console.log("change theme", changeTheme)
btn.addEventListener("click", changeTheme)

if (localStorage.getItem("theme") === "dark") {
    document.body.classList.add("dark")
