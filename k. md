- Improved my overall understanding of the Odoo framework and development workflow.function createFontSize() {
    const sizes = ["small", "medium", "large"];

    // Khôi phục từ localStorage
    let currentIndex = 1; // medium mặc định

    const savedSize = localStorage.getItem("fontSize");
    if (savedSize && sizes.includes(savedSize)) {
        currentIndex = sizes.indexOf(savedSize);
    }

    function render() {
        document.body.classList.remove(...sizes);
        document.body.classList.add(sizes[currentIndex]);

        localStorage.setItem("fontSize", sizes[currentIndex]);
    }

    return {
        init() {
            render();
        },

        toggle() {
            currentIndex = (currentIndex + 1) % sizes.length;
            render();
        },

        increase() {
            if (currentIndex < sizes.length - 1) {
                currentIndex++;
                render();
            }
        },

        decrease() {
            if (currentIndex > 0) {
                currentIndex--;
                render();
            }
        },

        getSize() {
            return sizes[currentIndex];
        }
    };
}
