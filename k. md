function createToggle(id, toggleClass) {
    const element = document.getElementById(id);
    let isOpen = false;

    function render() {
        element.classList.toggle(toggleClass, isOpen);
    }

    return {
        handleClick() {
            isOpen = !isOpen;
            render();
        },

        handleScroll() {
            if (window.scrollY > 300 && isOpen) {
                isOpen = false;
                render();
            }
        },

        handleKeydown(event) {
            if (event.key === "Escape" && isOpen) {
                isOpen = false;
                render();
            }
        },

        getState() {
            return isOpen;
        }
    };
